{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true, "allowJs": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"], "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
